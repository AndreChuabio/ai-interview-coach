# AI Interview Coach -- Provider Configuration
# Copy to .env and fill in the keys you need.
# Only the selected provider's key is required.

# -- LLM Provider --
# Options: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# -- STT Provider --
# Options: local_whisper, whisper_api, deepgram, google_stt
STT_PROVIDER=local_whisper
STT_MODEL=base

# -- TTS Provider --
# Options: edge_tts, openai_tts, elevenlabs, google_tts
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-GuyNeural

# -- API Keys (only fill in what you use) --
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# -- Ollama (local LLM) --
OLLAMA_URL=http://localhost:11434

# -- Application --
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
MAX_QUESTIONS=10
DEFAULT_INTERVIEW_TYPE=behavioral
