# AI Interview Coach -- Provider Configuration
# Copy to .env and fill in the keys you need.
# Only the selected provider's key is required.

# -- LLM Provider --
# Options: gemini, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# -- STT Provider --
# Options: local_whisper, whisper_api, deepgram
STT_PROVIDER=local_whisper
STT_MODEL=base

# -- TTS Provider --
# Options: edge_tts, openai_tts, elevenlabs
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-GuyNeural

# -- API Keys (only fill in what you use) --
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# -- Ollama (local LLM, no key needed) --
OLLAMA_URL=http://localhost:11434

# -- Neo4j (Knowledge Graph / RAG) --
# Leave blank to disable RAG -- the app works without it.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# -- Database (Session / Report Persistence) --
# SQLite for local dev, PostgreSQL for production.
DATABASE_URL=sqlite+aiosqlite:///./interview_coach.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/interview_coach

# -- Embedding Model --
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -- Application --
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
MAX_QUESTIONS=10
DEFAULT_INTERVIEW_TYPE=behavioral

# -- Deployment --
# For production, set CORS_ORIGINS to your deployed frontend URL:
#   CORS_ORIGINS=["https://your-app.vercel.app"]
# Azure App Service sets PORT automatically; gunicorn reads --bind from startup.sh.
# The frontend needs NEXT_PUBLIC_API_URL set in Vercel env vars:
#   NEXT_PUBLIC_API_URL=https://your-backend.azurewebsites.net/api
# For production PostgreSQL, use Neon or another hosted provider:
#   DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -- Provider Quick Reference --
#
# Zero-cost stack (development):
#   LLM_PROVIDER=ollama    LLM_MODEL=gemma2:2b
#   STT_PROVIDER=local_whisper
#   TTS_PROVIDER=edge_tts
#
# Budget stack (demo quality):
#   LLM_PROVIDER=gemini    LLM_MODEL=gemini-2.5-flash   GOOGLE_API_KEY=...
#   STT_PROVIDER=deepgram  DEEPGRAM_API_KEY=...
#   TTS_PROVIDER=edge_tts
#
# Premium stack (best quality):
#   LLM_PROVIDER=openai    LLM_MODEL=gpt-4o-mini        OPENAI_API_KEY=...
#   STT_PROVIDER=whisper_api                              OPENAI_API_KEY=...
#   TTS_PROVIDER=elevenlabs                               ELEVENLABS_API_KEY=...
